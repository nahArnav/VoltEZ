# Runtime mode: development, staging, or production.
ENVIRONMENT=development
PROJECT_NAME=VoltEZ API
VERSION=1.0.0

# Generate a production value with: openssl rand -hex 32
SECRET_KEY=local-development-secret-change-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Compose infrastructure. Change every production credential.
POSTGRES_DB=voltez
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Use explicit HTTPS origins in production; never use * with credentials.
# Include both loopback spellings for local Flutter web development.
# Replace with explicit HTTPS origins in staging/production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Payment values are server-side secrets except the public mobile key ID.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret
BOOKING_HOLD_FEE_INR=50
DEFAULT_PRICE_PER_KWH_INR=15

# Mobile build-time values (pass through --dart-define where documented).
API_BASE_URL=http://127.0.0.1:8000/api/v1
WS_BASE_URL=ws://127.0.0.1:8000/api/v1
GOOGLE_MAPS_API_KEY=

# Sponsor/external integrations. Never commit real values.
TAVILY_API_KEY=
SWYTCHCODE_API_KEY=
GEMINI_API_KEY=
LYZR_API_KEY=
N8N_WEBHOOK_URL=
MLFLOW_TRACKING_URI=
