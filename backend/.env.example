ENVIRONMENT=development
PROJECT_NAME=VoltEZ API
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=local-development-secret-change-before-deploying
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/voltez
GOOGLE_MAPS_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret
# Preferred payment gateway (Stripe Checkout activates when this is real).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
STRIPE_SUCCESS_URL=https://example.invalid/payment/success
STRIPE_CANCEL_URL=https://example.invalid/payment/cancel
BOOKING_HOLD_FEE_INR=50
DEFAULT_PRICE_PER_KWH_INR=15
