# VoltEZ Backend Environment Variables (.env.example)
# Copy this file to .env and configure your secrets

PROJECT_NAME=VoltEZ
ENVIRONMENT=development
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=development_secret_key_minimum_32_characters_long_for_hs256

# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://voltez:change_me@localhost:5432/voltez_db

# Redis (used for booking holds, ARQ background tasks, and session locks)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API Key (for AI Charging Assistant & Business Dashboard)
GEMINI_API_KEY=

# n8n Automation Engine Webhooks
N8N_BASE_URL=
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# External Sponsor & Integration Keys
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=
LYZR_API_KEY=
LYZR_AGENT_ID=
STARTUPED_API_KEY=
SWYTCHCODE_API_KEY=

# Payment Gateways (Stripe & Razorpay)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS Configuration (comma-separated origins or * for dev)
CORS_ORIGINS=*
